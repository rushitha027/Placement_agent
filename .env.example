# ============================================================
# AI Career Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ------ Required ------
OPENAI_API_KEY=sk-...your-openai-api-key-here...

# ------ Optional (defaults shown) ------
OPENAI_MODEL=gpt-3.5-turbo
AGENT_TEMPERATURE=0.3

# Port the server listens on (Render sets this automatically)
PORT=8000

# Comma-separated list of allowed CORS origins.
# Use * to allow all (fine for development / playground).
# Example for production: https://yourfrontend.com,https://app.yourfrontend.com
ALLOWED_ORIGINS=*

# LangSmith tracing (optional — remove if not using LangSmith)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...your-langsmith-key...
# LANGCHAIN_PROJECT=ai-career-agent
